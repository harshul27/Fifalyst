# FIFA World Cup 2026 - Environment Configuration
# Copy to .env.prod for production deployment

# PostgreSQL
POSTGRES_DB=fifa_wc_2026
POSTGRES_USER=fifa
POSTGRES_PASSWORD=change_me_to_secure_password

# Redis
REDIS_PASSWORD=change_me_to_secure_password

# Weaviate
WEAVIATE_API_KEY=change_me_to_secure_key

# Grafana
GRAFANA_PASSWORD=change_me_to_secure_password
GRAFANA_ADMIN_USER=admin

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me_to_secure_password

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ESPN API (if using real ESPN data)
ESPN_API_KEY=your_espn_api_key_here

# Claude API (for agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
