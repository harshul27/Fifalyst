        {
          "name": "final_score_away",
          "dataType": ["int"],
          "description": "Final score - away team"
        },
        {
          "name": "match_tempo",
          "dataType": ["text"],
          "description": "FAST, MODERATE, SLOW"
        },
        {
          "name": "possession_dominant",
          "dataType": ["text"],
          "description": "Which team dominated possession"
        },
        {
          "name": "embedding",
          "dataType": ["number[]"],
          "description": "256-dimensional match pattern embedding"
        }
      ]
    },
    {
      "class": "FatigueCurve",
      "description": "Typical fatigue patterns by position and player type",
      "vectorizer": "none",
      "vectorIndexType": "hnsw",
      "properties": [
        {
          "name": "curve_id",
          "dataType": ["int"],
          "description": "Unique curve ID"
        },
        {
          "name": "position",
          "dataType": ["text"],
          "description": "Playing position (GK, DEF, MID, ATT)"
        },
        {
          "name": "player_type",
