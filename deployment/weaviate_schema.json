      "vectorizer": "none",
      "vectorIndexType": "hnsw",
      "properties": [
        {
          "name": "match_id",
          "dataType": ["int"],
          "description": "Unique match ID"
        },
        {
          "name": "home_team",
          "dataType": ["text"],
          "description": "Home team name"
        },
        {
          "name": "away_team",
          "dataType": ["text"],
          "description": "Away team name"
        },
        {
          "name": "home_pes",
          "dataType": ["number"],
          "description": "Home team PES at match time"
        },
        {
          "name": "away_pes",
          "dataType": ["number"],
          "description": "Away team PES at match time"
        },
        {
          "name": "final_score_home",
          "dataType": ["int"],
          "description": "Final score - home team"
