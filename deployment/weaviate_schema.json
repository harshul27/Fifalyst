{
  "classes": [
    {
      "class": "Player",
      "description": "World Cup player with fitness and performance embeddings",
      "vectorizer": "none",
      "vectorIndexType": "hnsw",
      "vectorIndexConfig": {
        "skip": false,
        "cleanupIntervalSeconds": 300,
        "maxConnections": 64,
        "efConstruction": 128,
        "ef": 128,
        "dynamicEfMin": 100,
        "dynamicEfMax": 500,
        "dynamicEfFactor": 8,
        "flatSearchCutoff": 40000,
        "distance": "cosine"
      },
      "properties": [
        {
          "name": "player_id",
          "dataType": ["int"],
          "description": "Unique player ID from PostgreSQL"
        },
        {
          "name": "player_name",
          "dataType": ["text"],
          "description": "Player name"
        },
        {
          "name": "team",
          "dataType": ["text"],
          "description": "Team name"
        },
        {
          "name": "position",
          "dataType": ["text"],
          "description": "Playing position (GK, DEF, MID, ATT)"
        },
        {
          "name": "baseline_fitness",
          "dataType": ["number"],
          "description": "Baseline fitness score [0-100]"
        },
        {
          "name": "appearances",
          "dataType": ["int"],
          "description": "International appearances"
        },
        {
          "name": "goals",
          "dataType": ["int"],
          "description": "Career goals"
        },
        {
          "name": "assists",
          "dataType": ["int"],
          "description": "Career assists"
        },
        {
          "name": "rating",
          "dataType": ["number"],
          "description": "Player rating [0-10]"
        },
        {
          "name": "embedding",
          "dataType": ["number[]"],
          "description": "512-dimensional player fitness embedding"
        }
      ]
    },
    {
      "class": "Match",
