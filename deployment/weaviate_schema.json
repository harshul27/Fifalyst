        {
          "name": "fatigue_at_75min",
          "dataType": ["number"],
          "description": "Typical fatigue % at 75 minutes"
        },
        {
          "name": "fatigue_at_90min",
          "dataType": ["number"],
          "description": "Typical fatigue % at 90 minutes"
        },
        {
          "name": "anomaly_threshold",
          "dataType": ["number"],
          "description": "Stddev threshold for anomaly detection"
        },
